# Online payments (app/payments). Leave PAYMENT_PROVIDER empty to disable.
PAYMENT_PROVIDER=payhere
PAYHERE_MODE=sandbox            # sandbox | live
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PUBLIC_API_URL=                 # public https base URL of this server, used to build notify_url
CLIENT_RETURN_URL=              # customer-site page after payment
CLIENT_CANCEL_URL=
