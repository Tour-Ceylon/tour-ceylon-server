# Copy to .env and fill in. Never commit .env.
# Values are plain text: no quotes, and no "# comment" on the same line as a value.

# --- App ---
ENV=production
LOG_LEVEL=INFO
# Signs the emailed payment links. Required in production: generate with `openssl rand -hex 32`
SECRET_KEY=

# --- Database (Postgres, e.g. Supabase) ---
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME

# --- Clerk (sign-in) ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# PEM public key; write line breaks as \n so it stays on one line
CLERK_JWT_PUBLIC_KEY=
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUDIENCE=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISS=

# --- Web apps (CORS) ---
# CLIENT_APP_URL must be the CUSTOMER site: emailed payment links open <CLIENT_APP_URL>/pay/<code>
CLIENT_APP_URL=https://www.example.com
ADMIN_APP_URL=https://admin.example.com
# Extra allowed origins as a JSON list. The *.vercel.app apps are always allowed.
ADDITIONAL_CORS_ORIGINS=[]

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
INQUIRY_EMAIL=

# --- Images (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tour-ceylon

# --- Maps / routing (transfer prices) ---
GEOAPIFY_API_KEY=
# Google Maps key. The variable name really is "google-api" (with a hyphen).
google-api=

# --- Online payments (PayHere) ---
# Leave PAYMENT_PROVIDER empty to turn online payments off.
PAYMENT_PROVIDER=payhere
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Public https address of this server, used for PayHere's notify URL
PUBLIC_API_URL=
# Customer-site pages PayHere sends people back to
CLIENT_RETURN_URL=
CLIENT_CANCEL_URL=
# Hours the emailed "pay for your stay" link works
PAYMENT_LINK_TTL_HOURS=72
